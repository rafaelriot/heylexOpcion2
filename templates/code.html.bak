<!-- 4 Floating Confidence Pillars -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md mt-space-xl pt-space-lg">
<div class="bg-primary-container/60 backdrop-blur-md p-space-md rounded-xl shadow-sm flex items-start gap-space-md">
